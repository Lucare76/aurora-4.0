rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && currentUser().data.role == 'admin';
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isOwner() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function isCreatingOwner() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    function hasOnlyAllowedFields(data, allowed) {
      return data.keys().hasOnly(allowed);
    }

    function isValidLoanPayload() {
      return hasOnlyAllowedFields(
        request.resource.data,
        ['userId', 'title', 'borrowerName', 'amount', 'startDate', 'dueDate', 'notes', 'createdAt', 'updatedAt']
      )
      && request.resource.data.userId is string
      && request.resource.data.title is string
      && request.resource.data.amount is number;
    }

    function isValidAdminAuditPayload() {
      return hasOnlyAllowedFields(request.resource.data, ['adminUid', 'action', 'target', 'details', 'createdAt'])
      && request.resource.data.adminUid == request.auth.uid
      && request.resource.data.action is string
      && request.resource.data.action.size() > 0
      && request.resource.data.details is map;
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create: if isSelf(userId) && request.resource.data.role == 'user';
      allow update: if isAdmin() || (
        isSelf(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.approved == resource.data.approved
      );
      allow delete: if isAdmin();
    }

    match /users/{userId}/{subcollection}/{docId} {
      allow read, write: if isSelf(userId);
    }

    match /budgets/{docId} {
      allow read: if isOwner() || isAdmin();
      allow create: if isCreatingOwner();
      allow update: if isOwner() && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner() || isAdmin();
    }

    match /birthdays/{docId} {
      allow read: if isOwner() || isAdmin();
      allow create: if isCreatingOwner();
      allow update: if isOwner() && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner() || isAdmin();
    }

    match /savingsGoals/{docId} {
      allow read: if isOwner() || isAdmin();
      allow create: if isCreatingOwner();
      allow update: if isOwner() && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner() || isAdmin();
    }

    match /recurringTransactions/{docId} {
      allow read: if isOwner() || isAdmin();
      allow create: if isCreatingOwner();
      allow update: if isOwner() && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner() || isAdmin();
    }

    match /subscriptions/{docId} {
      allow read: if isOwner() || isAdmin();
      allow create: if isCreatingOwner();
      allow update: if isOwner() && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner() || isAdmin();
    }

    match /subscriptionPayments/{docId} {
      allow read: if isOwner() || isAdmin();
      allow create: if isCreatingOwner();
      allow update: if isOwner() && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner() || isAdmin();
    }

    match /subscriptionReconciliationLogs/{docId} {
      allow read: if isOwner() || isAdmin();
      allow create: if isCreatingOwner();
      allow update: if isOwner() && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner() || isAdmin();
    }

    match /accounts/{docId} {
      allow read: if isOwner() || isAdmin();
      allow create: if isCreatingOwner();
      allow update: if isOwner() && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner() || isAdmin();
    }

    match /categories/{docId} {
      allow read: if isOwner() || isAdmin();
      allow create: if isCreatingOwner();
      allow update: if isOwner() && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner() || isAdmin();
    }

    match /transactions/{docId} {
      allow read: if isOwner() || isAdmin();
      allow create: if isCreatingOwner();
      allow update: if isOwner() && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner() || isAdmin();
    }

    match /loans/{docId} {
      allow read: if isAdmin() && isOwner();
      allow create: if isAdmin() && isCreatingOwner() && isValidLoanPayload();
      allow update: if isAdmin() && isOwner() && request.resource.data.userId == resource.data.userId && isValidLoanPayload();
      allow delete: if isAdmin() && isOwner();
    }

    match /adminAuditLogs/{docId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidAdminAuditPayload();
      allow update, delete: if false;
    }
  }
}
